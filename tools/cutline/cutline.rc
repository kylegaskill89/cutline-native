// Windows resources for the application: the icon Explorer, the taskbar and
// Alt+Tab show, and the version block a right-click on the executable shows.
//
// The icon is first and numbered 1 on purpose. Windows picks the *lowest*
// numbered icon resource as an executable's representative one, so a second
// icon added later cannot silently take the application's identity.

#include <windows.h>

#define CUTLINE_ICON 1

CUTLINE_ICON ICON "cutline.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CUTLINE_VERSION_COMMAS
PRODUCTVERSION CUTLINE_VERSION_COMMAS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    // 0409 is British/US English, 04b0 is Unicode. Both are what every
    // installer and every properties dialog expects to find.
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Cutline"
      VALUE "FileDescription", "Cutline video editor"
      VALUE "FileVersion", CUTLINE_VERSION_STRING
      VALUE "InternalName", "cutline"
      VALUE "OriginalFilename", "cutline.exe"
      VALUE "ProductName", "Cutline"
      VALUE "ProductVersion", CUTLINE_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
