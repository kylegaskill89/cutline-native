#pragma once

/// What version this build is.
///
/// Generated by CMake from the project's version, so there is one place it is
/// written down. A number kept in two places is a number that will disagree
/// with itself the first time somebody bumps only one of them — and this one is
/// compared against what a release manifest says, so a stale copy means an
/// editor that never updates or one that offers to reinstall itself for ever.

#include <string_view>

namespace cutline::core {

inline constexpr int kVersionMajor = @PROJECT_VERSION_MAJOR@;
inline constexpr int kVersionMinor = @PROJECT_VERSION_MINOR@;
inline constexpr int kVersionPatch = @PROJECT_VERSION_PATCH@;

inline constexpr std::string_view kVersion = "@PROJECT_VERSION@";

}  // namespace cutline::core
